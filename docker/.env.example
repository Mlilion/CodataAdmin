# 数据库配置
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_DATABASE=codataadmin
MYSQL_USER=codataadmin
MYSQL_PASSWORD=CHANGE_ME_mysql_password
MYSQL_PORT=3306

# Redis配置
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6379

# 语义检索副库（compose 配置校验需要；未启用时也要有值才能通过变量插值）
SEM_PG_DB=semantic_retrieval
SEM_PG_USER=semantic
SEM_PG_PASSWORD=CHANGE_ME_semantic_pg_password
SEM_PG_PORT=5433

# 后端配置
BACKEND_PORT=8001

# Nginx配置
HTTP_PORT=80

# 项目配置
PROJECT_NAME=CodataAdmin

# 部署环境
DEPLOY_ENV=prod
